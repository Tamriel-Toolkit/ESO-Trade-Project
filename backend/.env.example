# ==============================================================================
# ESO Marketplace (Backend) — Environment Configuration Template
# ==============================================================================
# Copy this file to `backend/.env` for local development or configure these
# variables in your deployment environment (Docker, systemd, Kubernetes).
#
# Dotenv loading order in backend/server.js:
#   1. backend/.env
#   2. root .env (fallback)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Networking (Required / Standard)
# ------------------------------------------------------------------------------
# Port the Express server listens on.
PORT=5001

# Runtime environment: 'development', 'production', or 'test'.
# IMPORTANT: In production, setting this to 'production' enforces:
#   - Secure, HttpOnly, SameSite=None cookies (requires HTTPS).
#   - Strict disabling of all dev bypass and testing endpoints.
#   - Bounded CORS origin verification.
NODE_ENV=development

# Production Frontend URL for CORS origin verification.
# In development, localhost/127.0.0.1 origins are automatically permitted.
# In production, set this to the public URL of the frontend web application.
# Example: FRONTEND_URL=https://esomarketplace.example.com
FRONTEND_URL=

# ------------------------------------------------------------------------------
# 2. Database Storage (Required)
# ------------------------------------------------------------------------------
# Absolute or relative path to the SQLite application database.
# Default (if unset): backend/exports/eso_catalog.db
# For production Docker/containers, point to a persistent mounted volume.
# Example: DB_PATH=/var/lib/eso-trade/eso_catalog.db
DB_PATH=./exports/eso_catalog.db

# ------------------------------------------------------------------------------
# 3. Security, Sessions & Rate Limiting
# ------------------------------------------------------------------------------
# Session lifetime in hours for authenticated SQLite sessions (default: 168 = 7 days).
SESSION_TTL_HOURS=168

# ------------------------------------------------------------------------------
# 4. Developer & Testing Options (DEVELOPMENT ONLY — FORBIDDEN IN PRODUCTION)
# ------------------------------------------------------------------------------
# Opt-in flag to enable administrative testing endpoints (/api/dev/*).
# Note: server.js strictly prevents dev endpoints when NODE_ENV=production.
# Set to 'true' only when developing or running local test fixtures.
ENABLE_DEV_ENDPOINTS=false

# Optional development seed token overrides for pre-seeded test accounts (@Blake, @Demo).
# If left blank, random 16-byte hex tokens are generated automatically on startup.
# Leave blank in production.
BLAKE_API_TOKEN=
DEMO_API_TOKEN=

# ------------------------------------------------------------------------------
# 5. Native Ingestion Daemon (Optional)
# ------------------------------------------------------------------------------
# Bearer API token used by backend/data-pipeline/parse_esotrade_addon.py when
# uploading scans to a remote backend instance via HTTP (POST /api/market/upload-scans).
# Not required when running watcher.py on the same machine as the local SQLite database.
ESOTRADE_AUTH_TOKEN=

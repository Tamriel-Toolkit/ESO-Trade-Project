    <input type="image" src="https://www.paypalobjects.com/en_US/i/btn/btn_donate_SM.gif" border="0" name="submit" alt="PayPal - The safer, easier way to pay online!" class="block">
    <img alt="" border="0" src="https://www.paypalobjects.com/en_US/i/scr/pixel.gif" width="1" height="1">
</form>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    
    <div class="mx-auto max-w-7xl px-2 py-4 sm:py-8 md:px-4 lg:px-8">
        <div class="grid grid-cols-1 gap-6 md:grid-cols-12">
            
            <main class="md:col-span-12">
                <div class="rounded-lg border border-brand-primary/40 bg-brand-bg/90 backdrop-blur-md shadow-lg px-2 md:px-4 p-6 sm:shadow-[0_4px_12px_rgba(0,0,0,0.8)]">
                    <div class="mx-auto max-w-7xl px-0 py-4 md:px-4 lg:px-8">

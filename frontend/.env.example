# ==============================================================================
# ESO Marketplace (Frontend) — Environment Configuration Template
# ==============================================================================
# Copy this file to `frontend/.env` (or `frontend/.env.local`) to configure Vite.
#
# Vite Environment Rule:
#   Only variables prefixed with `VITE_` are exposed to client-side code via
#   `import.meta.env.VITE_*`. All other variables are ignored for security.
# ==============================================================================

# Build-time origin prefix for API requests and cached icons.
# Leave empty for the Vite dev proxy or a production same-origin /api proxy.
# Separate host example: https://api.example.com (never append /api).
VITE_API_BASE_URL=

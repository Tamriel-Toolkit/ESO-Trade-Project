# ==============================================================================
# ESO Marketplace (Frontend) — Environment Configuration Template
# ==============================================================================
# Copy this file to `frontend/.env` (or `frontend/.env.local`) to configure Vite.
#
# Vite Environment Rule:
#   Only variables prefixed with `VITE_` are exposed to client-side code via
#   `import.meta.env.VITE_*`. All other variables are ignored for security.
# ==============================================================================

# Base URL for Backend API requests.
#
# Development default:
#   VITE_API_BASE_URL=http://localhost:5001/api
#
# Production reverse-proxy deployment (e.g., Nginx serving frontend and proxying /api):
#   VITE_API_BASE_URL=/api
#
# Separate API host / subdomain deployment:
#   VITE_API_BASE_URL=https://api.esomarketplace.example.com/api
VITE_API_BASE_URL=http://localhost:5001/api

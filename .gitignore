backend/exports/items.json
backend/exports/*.db
backend/exports/*.db*
backend/exports/icon-cache/*
!backend/exports/icon-cache/.gitkeep
*.bak

# Ignore Node dependencies
node_modules/

# Environment variables & local overrides
.env
.env.local
.env.*.local

# Logs and OS files
*.log
.DS_Store
Thumbs.db
__pycache__/
*.pyc
